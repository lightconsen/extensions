{
  "id": "base64-tool",
  "name": "base64-tool",
  "version": "1.0.0",
  "description": "Encode and decode base64 without shelling out.",
  "author": "syscity",
  "main": "base64-tool.wasm",
  "capabilities": [
    {
      "type": "tools",
      "tools": [
        {
          "name": "base64",
          "description": "Encode or decode base64. mode=\"encode\" turns text into base64; mode=\"decode\" turns base64 back into text.",
          "parameters": {
            "type": "object",
            "properties": {
              "mode": { "type": "string", "enum": ["encode", "decode"] },
              "text": { "type": "string" }
            },
            "required": ["mode", "text"]
          }
        }
      ]
    }
  ],
  "permissions": [],
  "repository": "https://github.com/lightconsen/syscity"
}
